---
// Cada fato tem fonte em KURA_LANDING_PAGE_PLANO.md §0.3. Nada de número de
// cliente: o KURA não tem clínica pagante ainda, e a página não finge que tem.
const fatos = [
  { forte: 'Toda', texto: 'resposta que não é de alta urgência leva ao tutor o critério de quando procurar atendimento. É regra fixa do código, não depende da IA acertar.' },
  { forte: 'Sem diagnóstico', texto: 'a Luna prioriza a fila e diz o que levou à classificação. Quem diagnostica é o veterinário.' },
  { forte: 'Mais de 2.500', texto: 'testes automatizados nos cinco repositórios do sistema, medidos em setembro de 2026.' },
  { forte: 'NEXT FIAP 2026', texto: 'o KURA vai estar como expositor. Venha ver a Luna ao vivo.' },
];
---
<section class="fatos" aria-label="Fatos sobre o KURA">
  <ul class="wrap lista">
    {fatos.map((f) => <li><strong>{f.forte}</strong> {f.texto}</li>)}
  </ul>
</section>

<style>
  .fatos { border-block: 1px solid var(--border-strong); background: var(--surface-2); }
  .lista { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; margin: 0 auto; padding-block: 28px; }
  li { padding: 4px 24px; font-size: 0.95rem; line-height: 1.5; color: var(--text-soft); }
  li + li { border-left: 1px solid var(--border-strong); }
  li:first-child { padding-left: 0; }
  strong { display: block; font-family: var(--font-display); font-size: 1.6rem; font-weight: 500; color: var(--ocean); line-height: 1.1; margin-bottom: 4px; }
  @media (max-width: 900px) {
    .lista { grid-template-columns: 1fr 1fr; row-gap: 20px; }
    li:nth-child(3) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 520px) {
    .lista { grid-template-columns: 1fr; }
    li, li:nth-child(3) { border-left: 0; padding-left: 0; }
  }
</style>
