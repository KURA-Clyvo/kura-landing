---
// KuraMark (semente) — logo oficial por ruling L-2 (2026-09-24).
// Geometria copiada literalmente de Kura/brandbook-logo.jsx:9-25 (viewBox 0 0 40 48,
// proporção 5:6 — não distorcer). Cor: sage, a única em que o brand book mostra o mark.
interface Props { size?: number; color?: string; title?: string }
const { size = 32, color = 'var(--sage)', title } = Astro.props;
const body = 'M20 44 C8 44 4 34 4 24 C4 10 12 4 20 4 C28 4 36 10 36 24 C36 34 32 44 20 44Z';
---
<svg
  viewBox="0 0 40 48"
  width={size}
  height={(size * 48) / 40}
  fill="none"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <path d={body} fill={color} fill-opacity="0.18" />
  <path d="M20 44 L20 16" stroke={color} stroke-width="1.2" opacity="0.5" stroke-linecap="round" />
  <circle cx="20" cy="8" r="3.5" fill={color} />
  <circle cx="13" cy="12" r="2.8" fill={color} opacity="0.85" />
  <circle cx="27" cy="12" r="2.8" fill={color} opacity="0.85" />
  <path d={body} stroke={color} stroke-width="1.5" fill="none" opacity="0.7" />
</svg>
