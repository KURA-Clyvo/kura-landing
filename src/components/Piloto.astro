---
import FormPiloto from './FormPiloto.tsx';
import { WHATSAPP_PILOTO, RESPONSAVEL, PRECOS, linkWhatsApp } from '../config';
import '../styles/form.css';
const direto = linkWhatsApp('Olá! Quero entrar na lista do piloto do KURA para a minha clínica.');
---
<section class="section piloto" id="piloto" aria-labelledby="piloto-titulo">
  <div class="wrap grid">
    <div>
      <h2 id="piloto-titulo">Entre na lista do piloto.</h2>
      <p class="lede">
        São {PRECOS.vagasPiloto} vagas. O piloto abre quando o cadastro pela recepção
        estiver pronto, e a gente avisa você antes. A conversa continua no WhatsApp,
        direto com quem constrói o KURA.
      </p>
      <p class="alt">
        Prefere escrever do seu jeito? <a href={direto} target="_blank" rel="noopener">Abrir o WhatsApp sem formulário</a>.
      </p>
    </div>
    <div class="caixa">
      <FormPiloto client:idle numero={WHATSAPP_PILOTO} responsavel={RESPONSAVEL} />
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .lede { margin-top: 20px; }
  .alt { margin-top: 24px; color: var(--text-soft); }
  .caixa { padding: clamp(22px, 4vw, 36px); border-radius: var(--r-xl); background: var(--surface); border: 1px solid var(--border-strong); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
