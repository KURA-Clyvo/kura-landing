---
import { perguntas } from '../data/perguntas';
---
<section class="section" id="perguntas" aria-labelledby="faq-titulo">
  <div class="wrap estreito">
    <h2 id="faq-titulo">Perguntas que toda clínica faz.</h2>
    <div class="lista">
      {perguntas.map((p) => (
        <details>
          <summary>{p.q}</summary>
          <p>{p.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .estreito { max-width: 820px; }
  .lista { margin-top: 36px; border-top: 1px solid var(--border-strong); }
  details { border-bottom: 1px solid var(--border-strong); }
  summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; position: relative; font-weight: 500; font-size: 1.08rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 14px; font-size: 1.6rem; color: var(--ocean); transition: transform var(--d-base) var(--ease); }
  details[open] summary::after { transform: rotate(45deg); }
  details p { padding: 0 0 22px; color: var(--text-soft); max-width: 65ch; }
</style>
